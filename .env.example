# --- Local dev: app reads this (use after pulling prod to local) ---
DATABASE_URL="postgresql://user@localhost:5432/ibc"

# --- Pull Neon production → local (`pnpm db:pull:prod`; needs pg_dump / pg_restore from Homebrew libpq) ---
# Same URL you use for production; not read by `pnpm dev` if DATABASE_URL is local above.
# Production/preview on Vercel: use Neon's *pooled* host (-pooler in hostname), not DATABASE_URL_UNPOOLED.
# DATABASE_URL_PROD="postgresql://...@ep-xxx-pooler....neon.tech/ibc-db?sslmode=require"

# Drizzle CLI when TARGET=dev (optional)
# DATABASE_URL_DEV="postgresql://..."

# UploadThing (required for uploads)
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# App URL (for callbacks; optional for local)
# VITE_APP_URL="http://localhost:5173"

# Server-side search cache
# Local development: run a local Redis server and point REDIS_URL at it.
# REDIS_URL="redis://127.0.0.1:6379"
# Optional cache key prefix override (useful when sharing one Redis instance)
# IBC_CACHE_REDIS_PREFIX="ibc-dev"
# Vercel Preview: set IBC_CACHE_REDIS_PREFIX="ibc-preview" so preview deploys do not share prod Redis keys
# Deployment / serverless: prefer Upstash REST credentials.
# UPSTASH_REDIS_REST_URL="https://...upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
# Vercel KV-compatible aliases also work:
# KV_REST_API_URL="https://...upstash.io"
# KV_REST_API_TOKEN="..."

# Password reset (`/forgot-password`, admin “send reset email”) uses the same Resend vars as invitations.
# Requires `password_reset_tokens` table — run `pnpm db:ensure:password-reset` locally or rely on Vercel build ensure.
# Templates must expose variables: name, reset_url (user vs admin wording lives in each template).
# RESEND_PASSWORD_RESET_USER_TEMPLATE_ID="forgot-password-rest"
# (published id: fb1e0236-2c62-4153-9a48-67c71368a9f7 — use if alias is wrong)
# RESEND_PASSWORD_RESET_ADMIN_TEMPLATE_ID="admin-password-reset"
# (published id: f75f8218-da8b-4b48-82e3-da468d3bf0ab)
# Optional subject (API still sends subject alongside template)
# RESEND_PASSWORD_RESET_SUBJECT="Reset your Island Beer Club password"

# Existing-member rollout: `member_rollout_tokens` + `/member-rollout/activate/...` (not Prospect invites)
# pnpm db:ensure:member-rollout — defaults to template alias `island-beer-club-invite` (vars: inviterName, memberName, activationUrl).
# Gmail “…” / trimmed content while testing: repeated similar mails to one inbox stack in a thread and Gmail hides duplicate-looking sections—archive the thread or tweak RESEND_MEMBER_ROLLOUT_SUBJECT between sends.
# Set empty to force plain HTML instead: RESEND_MEMBER_ROLLOUT_TEMPLATE_ID=
# RESEND_MEMBER_ROLLOUT_TEMPLATE_ID="0fff1da1-6276-4223-89c3-8ab3ad583859"
# RESEND_MEMBER_ROLLOUT_SUBJECT="Activate your Island Beer Club member website account"

# Prospect → member: when an admin assigns MBR on `/dashboard/pending-members` (vars: memberName, memberNumber, profileUrl).
# Default template alias `island-beer-club-number`. Set empty for plain HTML only: RESEND_PROSPECT_PROMOTED_TEMPLATE_ID=
# RESEND_PROSPECT_PROMOTED_TEMPLATE_ID="a7b68c45-a3ba-4e63-b90d-8d3f1506c0ec"
# RESEND_PROSPECT_PROMOTED_SUBJECT="Welcome to Island Beer Club"

# Resend — optional; dashboard can still copy invite links without it
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Island Beer Club <noreply@yourdomain.com>"
# Template id or alias (vars: prospectName, invitingMemberName, inviteUrl). Default: invitation-to-join
# RESEND_INVITATION_TEMPLATE_ID="invitation-to-join"
# Optional subject override (send API requires subject; default uses invite label)
# RESEND_INVITATION_SUBJECT="You're invited to Island Beer Club"
# Member contact form (`/dashboard/contact`) — receives Resend sends (default: plain contact.form@islandbeerclub.com).
# Optional display name, same RFC format as RESEND_FROM_EMAIL:
# RESEND_CONTACT_TO_EMAIL="IBC Web Form Message <contact.form@islandbeerclub.com>"
# Template id or alias (vars: MESSAGE, SENDER_EMAIL, SENDER_NAME, SUBMITTED_AT). Default: contact-form-submission
# RESEND_CONTACT_TEMPLATE_ID="contact-form-submission"
# (or the published template UUID from the Resend dashboard)
# Optional subject override (API still requires subject alongside template)
# RESEND_CONTACT_SUBJECT="New message from islandbeerclub.com contact form"
