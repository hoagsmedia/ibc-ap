# --- Local dev: app reads this (use after pulling prod to local) ---
DATABASE_URL="postgresql://user@localhost:5432/ibc"

# --- Pull Neon production → local (`pnpm db:pull:prod`; needs pg_dump / pg_restore from Homebrew libpq) ---
# Same URL you use for production; not read by `pnpm dev` if DATABASE_URL is local above.
# DATABASE_URL_PROD="postgresql://...@...neon.tech/ibc-db?sslmode=require"

# Drizzle CLI when TARGET=dev (optional)
# DATABASE_URL_DEV="postgresql://..."

# UploadThing (required for uploads)
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# App URL (for callbacks; optional for local)
# VITE_APP_URL="http://localhost:5173"
