# Local development (create .env.local with these; .env.local is gitignored)
DATABASE_URL="postgresql://user:password@localhost:PORT/ibc"

# One-time: copy Neon → local Postgres (`pnpm db:pull:neon`; needs pg_dump/pg_restore, e.g. brew install libpq)
# NEON_DATABASE_URL="postgresql://...@...neon.tech/ibc-db?sslmode=require"
# LOCAL_DATABASE_URL="postgresql://user@localhost:5432/ibc"
# (Optional: omit LOCAL_DATABASE_URL if DATABASE_URL already points at localhost.)

# Neon (ibc-app project: production + development branches)
# For Vercel: set DATABASE_URL to Neon production branch URL for both Production and Preview.
# See DEPLOYMENT.md for Vercel + Neon setup.
# DATABASE_URL_DEV="postgresql://..."   # optional; TARGET=dev for db:push:dev / db:migrate:dev
# DATABASE_URL_PROD="postgresql://..." # optional; TARGET=prod for db:push:prod / db:migrate:prod

# UploadThing (required for uploads)
UPLOADTHING_TOKEN="your_uploadthing_token_here"

# App URL (for callbacks; optional for local)
# VITE_APP_URL="http://localhost:5173"
