{
	"name": "ibc-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts ",
		"db:generate:prod": "drizzle-kit generate --config=drizzle-prod.config.ts",
		"db:generate:dev": "drizzle-kit generate --config=drizzle-dev.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts ",
		"db:migrate:dev": "drizzle-kit migrate --config=drizzle-dev.config.ts ",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:push:prod": "drizzle-kit push --config=drizzle-prod.config.ts",
		"db:push:dev": "drizzle-kit push --config=drizzle-dev.config.ts",
		"db:seed:dev": "NODE_ENV=development tsx scripts/seed-users.ts",
		"db:seed": "tsx scripts/seed-users.ts",
		"db:studio": "drizzle-kit studio",
		"migrate:images": "tsx scripts/migrate-images.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.0",
		"@eslint/js": "^9.29.0",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.515.0",
		"@svelte-put/copy": "^4.0.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.10",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^22.15.33",
		"bits-ui": "^2.8.8",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.31.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.3",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"mdsvex": "^0.12.6",
		"mode-watcher": "^1.0.8",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"svelte": "^5.34.7",
		"svelte-check": "^4.2.2",
		"sveltekit-superforms": "^2.27.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.10",
		"tsx": "^4.20.3",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^6.3.5",
		"vitest": "3.1.4"
	},
	"dependencies": {
		"@neondatabase/serverless": "^0.10.4",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@types/pg": "^8.15.4",
		"@uploadthing/svelte": "^7.3.2",
		"@vercel/analytics": "^1.5.0",
		"argon2": "^0.43.0",
		"drizzle-orm": "^0.40.1",
		"drizzle-seed": "^0.3.1",
		"formsnap": "^2.0.1",
		"marked": "^16.0.0",
		"paneforge": "1.0.0-next.5",
		"pg": "^8.16.2",
		"postgres": "^3.4.7",
		"svelte-sonner": "^1.0.5",
		"uploadthing": "^7.7.3",
		"zod": "^3.25.67"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}