{
	"name": "ibc-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"build:vercel": "tsx scripts/ensure-users-schema.ts && tsx scripts/ensure-events-schema.ts && tsx scripts/ensure-stats-schema.ts && tsx scripts/ensure-invitation-tokens-schema.ts && tsx scripts/ensure-password-reset-tokens-schema.ts && tsx scripts/ensure-member-rollout-tokens-schema.ts && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:ts": "eslint vite.config.ts drizzle.config.ts scripts src --ignore-pattern \"**/*.svelte\"",
		"ci": "pnpm check && eslint . && vitest run && vite build",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:generate:dev": "cross-env TARGET=dev drizzle-kit generate --config=drizzle.config.ts",
		"db:generate:prod": "cross-env TARGET=prod drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"db:migrate:dev": "cross-env TARGET=dev drizzle-kit migrate --config=drizzle.config.ts",
		"db:migrate:prod": "cross-env TARGET=prod drizzle-kit migrate --config=drizzle.config.ts",
		"db:push": "drizzle-kit push --config=drizzle.config.ts",
		"db:push:dev": "cross-env TARGET=dev drizzle-kit push --config=drizzle.config.ts",
		"db:push:prod": "cross-env TARGET=prod drizzle-kit push --config=drizzle.config.ts",
		"db:seed:dev": "NODE_ENV=development tsx scripts/seed-users.ts",
		"db:seed": "tsx scripts/seed-users.ts",
		"db:seed:csv": "tsx scripts/seed-from-csv.ts",
		"db:sync:images": "tsx scripts/sync-uploadthing-images.ts",
		"db:studio": "drizzle-kit studio",
		"db:pull:prod": "bash scripts/pull-prod-to-local.sh",
		"db:ensure:stats:prod": "tsx scripts/ensure-stats-schema.ts --prod",
		"db:ensure:invites": "tsx scripts/ensure-invitation-tokens-schema.ts",
		"db:ensure:invites:prod": "tsx scripts/ensure-invitation-tokens-schema.ts --prod",
		"db:ensure:password-reset": "tsx scripts/ensure-password-reset-tokens-schema.ts",
		"db:ensure:member-rollout": "tsx scripts/ensure-member-rollout-tokens-schema.ts",
		"db:ensure:member-rollout:prod": "tsx scripts/ensure-member-rollout-tokens-schema.ts --prod",
		"db:ensure:password-reset:prod": "tsx scripts/ensure-password-reset-tokens-schema.ts --prod",
		"db:export:stats": "tsx scripts/export-club-stats-snapshot.ts",
		"db:export:stats:prod": "tsx scripts/export-club-stats-snapshot.ts --prod",
		"db:export:events": "tsx scripts/export-events-public-snapshot.ts",
		"db:export:events:prod": "tsx scripts/export-events-public-snapshot.ts --prod",
		"db:import:stats": "tsx scripts/import-legacy-stats-html.ts",
		"db:import:stats:prod": "tsx scripts/import-legacy-stats-html.ts --prod",
		"db:pull:neon": "bash scripts/pull-prod-to-local.sh",
		"db:migrate:neon-stakeholder": "bash scripts/migrate-neon-prod-to-stakeholder.sh",
		"db:sanitize:neon-cutover": "tsx scripts/sanitize-neon-prod-cutover.ts",
		"migrate:images": "tsx scripts/migrate-images.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.3.0",
		"@eslint/js": "^9.29.0",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.8.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-vercel": "^5.7.2",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/vite": "^4.1.10",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^22.15.33",
		"@types/pg": "^8.15.4",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"cross-env": "^7.0.3",
		"d3-scale": "^4.0.2",
		"dotenv": "^16.5.0",
		"drizzle-kit": "^0.31.2",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.3",
		"fallow": "^2.63.0",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"layerchart": "2.0.0-next.48",
		"mdsvex": "^0.12.6",
		"mode-watcher": "^1.0.8",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"svelte": "^5.34.7",
		"svelte-check": "^4.2.2",
		"sveltekit-superforms": "^2.27.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.10",
		"tsx": "^4.20.3",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.0",
		"vite": "^6.3.5",
		"vitest": "3.1.4"
	},
	"dependencies": {
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@uploadthing/svelte": "^7.3.3",
		"@upstash/redis": "^1.38.0",
		"@vercel/analytics": "^1.5.0",
		"argon2": "^0.43.0",
		"csv-parse": "^6.1.0",
		"drizzle-orm": "^0.40.1",
		"formsnap": "^2.0.1",
		"postgres": "^3.4.7",
		"redis": "^5.12.1",
		"resend": "^6.12.2",
		"svelte-sonner": "^1.0.5",
		"uploadthing": "^7.7.4",
		"zod": "^3.25.67"
	},
	"optionalDependencies": {
		"@fallow-cli/darwin-arm64": "2.63.0"
	},
	"engines": {
		"node": "22.x"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"argon2",
			"esbuild",
			"fallow",
			"msgpackr-extract"
		]
	}
}
